{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Miro-CogSec Review Output",
  "type": "object",
  "required": ["id", "reviewer", "decision", "confidence", "issues", "suggested_patch"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "reviewer": {"type": "string"},
    "decision": {"enum": ["approve", "revise", "reject", "needs_human"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "field", "comment"],
        "properties": {
          "severity": {"enum": ["low", "medium", "high"]},
          "field": {"type": "string"},
          "comment": {"type": "string"}
        }
      }
    },
    "suggested_patch": {"type": ["object", "null"]},
    "human_review": {
      "type": "object",
      "properties": {
        "decision": {"type": "string"},
        "notes": {"type": "string"},
        "reviewer": {"type": "string"}
      }
    }
  }
}
