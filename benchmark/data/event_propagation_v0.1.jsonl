tep": 3, "label": "新闻账号放大后、身份信息被广泛二次传播前"}, "expected_containment_action": "标注未确认身份信息，要求转发账号更新更正，并将权威更正与原传播链绑定展示。", "evidence_spans": ["首发帖", "多个新闻账号和个人账号转发", "未经证实的嫌疑人身份", "现场图片单独传播", "权威账号发布更正", "身份信息不准确"], "evidence_pack": [{"id": "ev:首发帖", "span": "首发帖", "evidence_type": "direct_text", "supports": ["origin_node"], "confidence": 0.94}, {"id": "ev:新闻账号", "span": "多个新闻账号", "evidence_type": "direct_text", "supports": ["amplifier_nodes", "propagation_path"], "confidence": 0.88}, {"id": "ev:个人账号", "span": "个人账号转发", "evidence_type": "direct_text", "supports": ["amplifier_nodes", "propagation_path"], "confidence": 0.86}, {"id": "ev:嫌疑人身份", "span": "未经证实的嫌疑人身份", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.96}, {"id": "ev:现场图片单独传播", "span": "现场图片单独传播", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.9}, {"id": "ev:权威更正", "span": "权威账号发布更正", "evidence_type": "direct_text", "supports": ["containment_window", "expected_containment_action"], "confidence": 0.9}], "review_notes": ["基于 PHEME conversation-thread 类数据结构构造。", "不复制原始 tweet；保留传播链和更正节点。"]}, "annotation": {"annotator": "human_cogsec_seed", "review_status": "gold_reviewed", "created_at": "2026-06-07", "prompt_version": "event_propagation_seed_v0.1", "reviewed_at": "2026-06-08", "reviewer": "human_in_loop_codex_session"}}
{"id": "event-propagation-v0.1-002", "scenario_type": "event_propagation", "source": {"dataset": "CrisisLexT26", "url": "https://crisislex.org/data-collections.html#CrisisLexT26", "license": "research dataset; tweet content subject to platform terms", "split": "crisis_event_seed", "event": "natural disaster social media crisis communication", "relation": "normalized_crisis_propagation_trace_from_open_dataset_description"}, "input": {"language": "zh-CN", "channel": "propagation_trace_summary", "text": "自然灾害发生后，一条求助信息从本地用户账号发出，随后被志愿者群组、地方媒体和救援信息汇总账号转发。传播过程中，地点名称被简写，部分转发遗漏了发布时间，导致后续用户误以为求助仍然实时有效。", "sanitization": ["trace_level_summary", "no_user_handle", "no_original_tweet_text"]}, "answer": {"event_summary": "灾害求助信息在多类节点间扩散，地点和时间上下文在转发中丢失，造成过期求助被误认为实时有效。", "origin_node": {"id": "node:local_help_request", "type": "local_source", "description": "本地用户发出的初始求助信息。", "evidence_refs": ["ev:本地用户账号"]}, "amplifier_nodes": [{"id": "node:volunteer_group", "type": "community_amplifier", "description": "志愿者群组转发求助信息。", "evidence_refs": ["ev:志愿者群组"]}, {"id": "node:local_media", "type": "media_amplifier", "description": "地方媒体扩大覆盖面。", "evidence_refs": ["ev:地方媒体"]}, {"id": "node:rescue_aggregator", "type": "aggregation_amplifier", "description": "救援信息汇总账号继续转发。", "evidence_refs": ["ev:救援信息汇总账号"]}], "propagation_path": [{"step": 1, "node": "node:local_help_request", "action": "发布求助信息", "risk_state": "信息具体但覆盖有限"}, {"step": 2, "node": "node:volunteer_group", "action": "社区转发", "risk_state": "覆盖扩展"}, {"step": 3, "node": "node:local_media", "action": "媒体转发", "risk_state": "可信度和覆盖面上升"}, {"step": 4, "node": "node:rescue_aggregator", "action": "汇总账号转发但遗漏时间", "risk_state": "时效性失真"}], "distortion_points": [{"id": "distortion:location_abbreviation", "description": "地点名称被简写，可能影响定位准确性。", "severity": 0.58, "evidence_refs": ["ev:地点名称被简写"]}, {"id": "distortion:timestamp_loss", "description": "发布时间遗漏导致过期求助被当作实时信息。", "severity": 0.84, "evidence_refs": ["ev:遗漏发布时间", "ev:实时有效"]}], "coverage_risk": "medium", "containment_window": {"open_step": 2, "close_step": 3, "label": "在汇总账号二次扩散前补齐地点和时间上下文"}, "expected_containment_action": "转发时强制保留原始发布时间、地点全称和状态更新；对已解决或过期求助加醒目标记。", "evidence_spans": ["本地用户账号", "志愿者群组", "地方媒体", "救援信息汇总账号", "地点名称被简写", "遗漏了发布时间", "误以为求助仍然实时有效"], "evidence_pack": [{"id": "ev:本地用户账号", "span": "本地用户账号", "evidence_type": "direct_text", "supports": ["origin_node"], "confidence": 0.92}, {"id": "ev:志愿者群组", "span": "志愿者群组", "evidence_type": "direct_text", "supports": ["amplifier_nodes"], "confidence": 0.86}, {"id": "ev:地方媒体", "span": "地方媒体", "evidence_type": "direct_text", "supports": ["amplifier_nodes"], "confidence": 0.86}, {"id": "ev:救援信息汇总账号", "span": "救援信息汇总账号", "evidence_type": "direct_text", "supports": ["amplifier_nodes"], "confidence": 0.86}, {"id": "ev:地点名称被简写", "span": "地点名称被简写", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.9}, {"id": "ev:遗漏发布时间", "span": "遗漏了发布时间", "evidence_type": "direct_text", "supports": ["distortion_points", "containment_window"], "confidence": 0.94}, {"id": "ev:实时有效", "span": "误以为求助仍然实时有效", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.92}], "review_notes": ["CrisisLexT26 面向危机事件社媒信息分类，本样本抽象危机传播中的地点/时间上下文丢失问题。", "Human review adjusted containment_window.close_step from 4 to 3 so the window closes before aggregation-account amplification."]}, "annotation": {"annotator": "human_cogsec_seed", "review_status": "gold_reviewed", "created_at": "2026-06-07", "prompt_version": "event_propagation_seed_v0.1", "reviewed_at": "2026-06-08", "reviewer": "human_in_loop_codex_session"}}
{"id": "event-propagation-v0.1-003", "scenario_type": "event_propagation", "source": {"dataset": "FakeNewsNet", "url": "https://github.com/KaiDMML/FakeNewsNet", "dataverse_url": "https://doi.org/10.7910/DVN/UEMMHS", "license": "check_upstream_terms_before_redistribution; tweet ids only for social context", "split": "social_context_seed", "event": "news with social propagation context", "relation": "normalized_cross_platform_trace_from_open_dataset_description"}, "input": {"language": "zh-CN", "channel": "propagation_trace_summary", "text": "一篇争议性新闻先在新闻网站发布，随后被社交平台用户截取标题和首段转发。几小时后，截图被搬运到另一个平台，原文中的限定条件和更新说明被裁掉，新的讨论开始围绕更绝对化的说法扩散。", "sanitization": ["article_social_context_summary", "no_original_article_text", "no_user_handle"]}, "answer": {"event_summary": "争议新闻从网站到社交平台再到跨平台截图传播，限定条件和更新说明在搬运中丢失，形成更绝对化的新叙事。", "origin_node": {"id": "node:news_article", "type": "article_source", "description": "新闻网站发布的原始文章。", "evidence_refs": ["ev:新闻网站发布"]}, "amplifier_nodes": [{"id": "node:title_screenshot_users", "type": "screenshot_amplifier", "description": "用户截取标题和首段转发。", "evidence_refs": ["ev:截取标题和首段"]}, {"id": "node:cross_platform_repost", "type": "cross_platform_amplifier", "description": "截图被搬运到另一个平台。", "evidence_refs": ["ev:另一个平台"]}], "propagation_path": [{"step": 1, "node": "node:news_article", "action": "原始文章发布", "risk_state": "包含限定条件和更新说明"}, {"step": 2, "node": "node:title_screenshot_users", "action": "截取标题和首段转发", "risk_state": "上下文开始缩减"}, {"step": 3, "node": "node:cross_platform_repost", "action": "跨平台搬运截图", "risk_state": "限定条件和更新说明丢失"}, {"step": 4, "node": "node:new_discussion_cluster", "action": "围绕绝对化说法扩散", "risk_state": "叙事失真扩大"}], "distortion_points": [{"id": "distortion:condition_removed", "description": "原文限定条件被裁掉。", "severity": 0.82, "evidence_refs": ["ev:限定条件裁掉"]}, {"id": "distortion:update_removed", "description": "更新说明被裁掉，后续讨论基于过时信息。", "severity": 0.8, "evidence_refs": ["ev:更新说明裁掉"]}, {"id": "distortion:absolutized_claim", "description": "新讨论围绕更绝对化说法扩散。", "severity": 0.78, "evidence_refs": ["ev:绝对化说法"]}], "coverage_risk": "high", "containment_window": {"open_step": 2, "close_step": 3, "label": "截图跨平台搬运前补齐原文链接和上下文"}, "expected_containment_action": "为截图传播补充原文链接、限定条件和更新说明；对跨平台搬运内容标注上下文缺失。", "evidence_spans": ["新闻网站发布", "截取标题和首段转发", "搬运到另一个平台", "限定条件和更新说明被裁掉", "更绝对化的说法扩散"], "evidence_pack": [{"id": "ev:新闻网站发布", "span": "新闻网站发布", "evidence_type": "direct_text", "supports": ["origin_node"], "confidence": 0.9}, {"id": "ev:截取标题和首段", "span": "截取标题和首段转发", "evidence_type": "direct_text", "supports": ["amplifier_nodes", "propagation_path"], "confidence": 0.92}, {"id": "ev:另一个平台", "span": "搬运到另一个平台", "evidence_type": "direct_text", "supports": ["amplifier_nodes"], "confidence": 0.9}, {"id": "ev:限定条件裁掉", "span": "限定条件和更新说明被裁掉", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.92}, {"id": "ev:更新说明裁掉", "span": "限定条件和更新说明被裁掉", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.92}, {"id": "ev:绝对化说法", "span": "更绝对化的说法扩散", "evidence_type": "direct_text", "supports": ["distortion_points"], "confidence": 0.88}], "review_notes": ["FakeNewsNet 提供新闻与社交上下文，本样本用于评估跨平台截图传播中的上下文丢失。"]}, "annotation": {"annotator": "human_cogsec_seed", "review_status": "gold_reviewed", "created_at": "2026-06-07", "prompt_version": "event_propagation_seed_v0.1", "reviewed_at": "2026-06-08", "reviewer": "human_in_loop_codex_session"}}
{"id": "event-propagation-v0.1-004", "scenario_type": "event_propagation", "source": {"dataset": "PHEME Rumour Detection and Veracity Classification", "url": "https://figshare.com/articles/dataset/PHEME_dataset_for_Rumour_Detection_and_Veracity_Classification/6392078", "license": "CC BY 4.0 annotations; Twitter content rights retained by Twitter", "split": "conversation_thread_seed", "event": "Sydney siege", "relation": "normalized_amplifier_trace_from_open_dataset_metadata"}, "input": {"language": "zh-CN", "channel": "propagation_trace_summary", "text": "突发事件期间，一条关于现场状况的传言在少数账号中出现。一个高影响力账号引用该传言并加入判断性措辞后，转发量迅速上升。稍后多个回复指出信息未被证实，但原始高影响力转发仍继续被引用。", "sanitization": ["trace_level_summary", "no_user_handle", "no_original_tweet_text"]}, "answer": {"event_summary": "突发事件传言经高影响力账号放大，纠错回复出现后仍难以覆盖原始高影响力转发。", "origin_node": {"id": "node:small_account_rumour", "type": "early_rumour_source", "description": "少数账号中出现的现场状况传言。", "evidence_refs": ["ev:少数账号"]}, "amplifier_nodes": [{"id": "node:high_influence_account", "type": "high_influence_amplifier", "description": "高影响力账号引用传言并加入判断性措辞。", "evidence_refs": ["ev:高影响力账号", "ev:判断性措辞"]}], "propagation_path": [{"step": 1, "node": "node:small_account_rumour", "action": "传言出现", "risk_state": "低覆盖但未核实"}, {"step": 2, "node": "node:high_influence_account", "action": "高影响力账号引用并判断化", "risk_state": "覆盖和可信感上升"}, {"step": 3, "node": "node:reply_corrections", "action": "回复指出未证实", "risk_state": "出现纠错但覆盖有限"}, {"step": 4, "node": "node:continued_reposts", "action": "原始高影响力转发继续被引用", "risk_state": "纠错滞后"}], "distortion_points": [{"id": "distortion:judgment_added", "description": "引用时加入判断性措辞，使未证实信息看起来更确定。", "severity": 0.82, "evidence_refs": ["ev:判断性措辞"]}, {"id": "distortion:correction_not_attached", "description": "纠错回复未能附着到继续传播的高影响力转发。", "severity": 0.76, "evidence_refs": ["ev:仍继续被引用"]}], "coverage_risk": "high", "containment_window": {"open_step": 1, "close_step": 2, "label": "高影响力账号引用前是最佳阻断窗口；引用后应立即绑定纠错"}, "expected_containment_action": "对高影响力转发加未证实标注，