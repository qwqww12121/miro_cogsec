{"id": "cogsec-v0.1-001", "source": {"dataset": "ChiFraud", "url": "https://github.com/xuemingxxx/ChiFraud", "license": "CC BY-NC 4.01", "split": "t2022", "label_id": 8, "label_name": "虚假手机卡", "relation": "sanitized_normalized_public_sample"}, "input": {"language": "zh-CN", "channel": "short_text_ad", "text": "广告称可以买到已实名激活手机卡，留下微信联系，强调多年老店和信誉第一。", "sanitization": ["contact_removed", "number_normalized"]}, "scenario_type": "fraud_im"}
