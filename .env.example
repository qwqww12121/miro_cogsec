# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== CogSec-MiroFish 配置 =====
CHROMA_PATH=./data/chroma_db
CHROMADB_PATH=./data/chroma_db
FRAUD_CASE_DB_PATH=./data/fraud_cases.json
LOCAL_SANITIZE_ENABLED=true
MAX_SIMULATION_STEPS=10
RISK_THRESHOLD_CRITICAL=20
BRANCH_FORK_MODE=parallel
LIWC_DICT_PATH=./data/liwc_chinese.json
PRESIDIO_ENABLED=true
T0_PATTERNS_PATH=./data/t0_regex_patterns.json
FALLBACK_MODEL=qwen2-7b-instruct
RISK_SCORE_THRESHOLD_CRITICAL=0.85
REVERSIBILITY_WARN_THRESHOLD=0.3
COGSEC_RUNTIME_TIMEOUT_SEC=15
MIROFISH_STRICT_CONFIG=false

# ===== 本地 Gemma 配置（可选）=====
# 仅本地运行 CogSec 时，可设置为 true，暂时替代 LLM_API_KEY
COGSEC_USE_LOCAL_GEMMA=true
COGSEC_LOCAL_MODEL_PATH=./models/google--gemma-4-E2B-it
COGSEC_LOCAL_GEMMA_DEVICE=auto
COGSEC_LOCAL_GEMMA_DTYPE=auto
COGSEC_LOCAL_GEMMA_MAX_NEW_TOKENS=768
COGSEC_LOCAL_GEMMA_OFFLOAD_DIR=./backend/.cache/gemma_offload
