# Copy this file to `.env` and fill in your own values.
# Never commit `.env`. Use obvious placeholders, not look-alike keys.

FLASK_DEBUG=true
SECRET_KEY=YOUR_SECRET_KEY

# Upstream analysis model (OpenAI-compatible)
MIRO_COGSEC_MAIN_LLM_API_KEY=YOUR_API_KEY
MIRO_COGSEC_MAIN_LLM_BASE_URL=https://api.example.com/v1
MIRO_COGSEC_MAIN_LLM_MODEL=YOUR_MODEL_NAME
MIRO_COGSEC_MAIN_LLM_CONNECT_TIMEOUT_SEC=15
MIRO_COGSEC_MAIN_LLM_READ_TIMEOUT_SEC=45
MIRO_COGSEC_MAIN_LLM_RETRIES=1
MIRO_COGSEC_PROFILE_MODE=auto

# Optional compatibility: only set true if you still use the legacy LLM_* names.
MIRO_COGSEC_ALLOW_LEGACY_LLM_KEY=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Optional OASIS-only credentials. Do not reuse the main/judge key implicitly.
MIRO_COGSEC_OASIS_API_KEY=
MIRO_COGSEC_OASIS_BASE_URL=
MIRO_COGSEC_OASIS_MODEL=
MIRO_OASIS_VERIFICATION_QUICK_MODE=true
MIRO_OASIS_VERIFICATION_K=1
MIRO_OASIS_VERIFICATION_SEED=42
MIRO_OASIS_QUICK_N_AGENTS=12
MIRO_OASIS_QUICK_TICKS=5
MIRO_OASIS_TIMEOUT_SEC=10

# Final answer policy
# auto: dedicated reporter if fully configured, otherwise main LLM
# remote_model / main_llm / deterministic / local_model / trained_policy
MIRO_REPORTER_POLICY_MODE=auto
MIRO_REPORTER_API_KEY=
MIRO_REPORTER_BASE_URL=
MIRO_REPORTER_MODEL=
MIRO_REPORTER_OUTPUT_MAX_TOKENS=1400
MIRO_REPORTER_CONNECT_TIMEOUT_SEC=15
MIRO_REPORTER_READ_TIMEOUT_SEC=45
MIRO_REPORTER_RETRIES=1
MIRO_REPORTER_ENABLE_THINKING=false
MIRO_REPORTER_MODEL_PATH=
MIRO_REPORTER_ADAPTER_PATH=

# Internal fraud agent action policy. Deterministic is the fast default.
MIRO_FRAUD_AGENT_POLICY_MODE=deterministic

# Optional speech transcription. Browser SpeechRecognition is tried first.
MIRO_SPEECH_PROVIDER=auto
MIRO_SPEECH_API_KEY=
MIRO_SPEECH_BASE_URL=
MIRO_SPEECH_MODEL=whisper-1
MIRO_SPEECH_LANGUAGE=zh
MIRO_SPEECH_CONNECT_TIMEOUT_SEC=15
MIRO_SPEECH_READ_TIMEOUT_SEC=120
MIRO_SPEECH_LOCAL_MODEL=small
MIRO_SPEECH_LOCAL_DEVICE=cpu
MIRO_SPEECH_LOCAL_COMPUTE_TYPE=int8

# Independent blind judge (OpenAI-compatible)
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL_NAME=
JUDGE_ENABLE_THINKING=false
LLM_ENABLE_THINKING=false

# Optional Zep Cloud graph memory (legacy MiroFish path)
ZEP_API_KEY=

# Training is opt-in and still requires a real trainer/environment.
ENABLE_PPO_TRAINING=false
ENABLE_REPORTER_TRAINING=false
MIRO_PPO_POLICY_PATH=
MIRO_INTERVENTION_POLICY_MODE=ranker

COGSEC_USE_LOCAL_GEMMA=false
PRESIDIO_ENABLED=false
LOCAL_SANITIZE_ENABLED=true
ENABLE_LEGACY_MIROFISH_API=false

# Relative to the backend working directory when you start from backend/
CHROMA_PATH=../data/chroma_db
